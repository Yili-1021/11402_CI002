#include <iostream>
#include <vector>
#include <string>
using namespace std;

// 定義 8 個方向的偏移量
int dx[] = {-1, -1, -1,  0, 0,  1, 1, 1};
int dy[] = {-1,  0,  1, -1, 1, -1, 0, 1};

int main() {
    int n, m, field_num = 1;
    bool first_field = true;

    while (cin >> n >> m && (n != 0 || m != 0)) {
        // 格式控制：除了第一個 Field 之外，其餘 Field 輸出前都要多空一行
        if (!first_field) {
            cout << endl;
        }
        first_field = false;

        vector<string> grid(n);
        for (int i = 0; i < n; i++) {
            cin >> grid[i];
        }

        cout << "Field #" << field_num++ << ":" << endl;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                // 如果本身就是地雷，直接輸出 '*'
                if (grid[i][j] == '*') {
                    cout << '*';
                } else {
                    int mine_count = 0;
                    // 檢查周圍 8 個方向
                    for (int d = 0; d < 8; d++) {
                        int ni = i + dx[d];
                        int nj = j + dy[d];

                        // 邊界檢查與地雷判定
                        if (ni >= 0 && ni < n && nj >= 0 && nj < m) {
                            if (grid[ni][nj] == '*') {
                                mine_count++;
                            }
                        }
                    }
                    cout << mine_count;
                }
            }
            cout << endl;
        }
    }
    return 0;
}
