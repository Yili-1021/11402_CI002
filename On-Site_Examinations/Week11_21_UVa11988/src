#include <iostream>
#include <string>
using namespace std;

int main() {
    string s;
    while (cin >> s) {
        string a = "";
        string t = "";
        bool front = false;
        for (char c : s) {
            if (c == '[') {
                a = t + a;
                t = "";
                front = true;
            }
            else if (c == ']') {
                a = t + a;
                t = "";
                front = false;
            }
            else {
                if (front) t += c;
                else a = t + a; // 這裡每次字元輸入都進行字串拼接
            }
        }
        cout << a << endl;
    }
    return 0;
}
