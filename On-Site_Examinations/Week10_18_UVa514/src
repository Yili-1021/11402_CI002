#include <iostream>
#include <stack>
using namespace std;

int main() {
    int n;
    while (cin >> n && n) { // 外層：處理多組測資
        while (true) {      // 內層：處理每個排列
            int target[1000];
            cin >> target[0];
            if (target[0] == 0) break; // 結束這組 n 的排列
            for (int i = 1; i < n; i++) cin >> target[i];

            stack<int> st;
            int current = 1; // 目前進站的車廂編號
            bool ok = true;

            for (int i = 0; i < n; i++) {
                while (current <= target[i]) {
                    st.push(current++);
                }
                if (st.top() == target[i]) st.pop();
                else { ok = false; break; }
            }

            cout << (ok ? "Yes" : "No") << endl;
        }
        cout << endl; // 每組測資之間要空一行
    }
}
