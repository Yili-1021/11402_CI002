#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int main()
{
	int n;
	cin >> n;
	while (n--) {
		int num;
		cin >> num;
		vector<int> map(num);
		for (int i = 0;i < num;i++) {
			cin >> map[i];
		}
		sort(map.begin(), map.end());
		int midmap = map[num - 1] - map[0];
		int total = midmap * 2;
		cout << total << endl;
	}
}
